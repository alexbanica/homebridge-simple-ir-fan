{
  "name": "homebridge-simple-ir-fan",
  "displayName": "SimpleIrFan",
  "type": "module",
  "version": "1.0.0",
  "description": "Allows you to control a fan via HTTP API endpoints configured per action.",
  "author": "Ionut Alexandru Banica",
  "license": "Apache-2.0",
  "homepage": "https://github.com/alexbanica/homebridge-simple-ir-fan#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexbanica/homebridge-simple-ir-fan.git"
  },
  "bugs": {
    "url": "https://github.com/alexbanica/homebridge-simple-ir-fan/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "homebridge",
    "plugin",
    "fan",
    "http"
  ],
  "main": "dist/index.js",
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "LICENSE*"
  ],
  "publishConfig": {
    "registry": "https://forgejo.alexlab.nl/api/packages/public/npm/",
    "access": "public"
  },
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "publish:forgejo": "node ./scripts/publish-forgejo.mjs",
    "test": "rimraf ./.test-dist && tsc -p tsconfig.test.json && node --test --test-concurrency=1 .test-dist/test/*.test.js --test-reporter=spec --test-isolation=none",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon"
  },
  "dependencies": {
    "homebridge-lib": "^7.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "homebridge": "^2.0.0-beta.30",
    "nodemon": "^3.1.10",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0"
  },
  "homebridge": {
    "schema": {
      "pluginAlias": "SimpleIrFan",
      "pluginType": "platform",
      "singular": true,
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "title": "Platform Name",
            "default": "SimpleIrFan"
          },
          "devices": {
            "type": "array",
            "title": "Fans",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "manufacturer", "model", "serialNumber", "endpoints"],
              "properties": {
                "name": { "type": "string" },
                "manufacturer": { "type": "string", "default": "Generic" },
                "model": { "type": "string", "default": "Fan" },
                "serialNumber": { "type": "string" },
                "timeoutMs": { "type": "integer", "minimum": 1, "default": 5000 },
                "endpoints": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["getStatus"],
                  "properties": {
                    "start": { "$ref": "#/definitions/endpoint" },
                    "stop": { "$ref": "#/definitions/endpoint" },
                    "setSpeed": { "$ref": "#/definitions/endpoint" },
                    "getStatus": { "$ref": "#/definitions/endpoint" },
                    "rotate": {
                      "type": "object",
                      "title": "Rotation Toggle",
                      "required": ["uri", "method"],
                      "additionalProperties": false,
                      "properties": {
                        "uri": {
                          "type": "string",
                          "title": "URI",
                          "format": "uri",
                          "pattern": "^https?:\\/\\/(?![^/\\s?#]*@)(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*|\\d{1,3}(?:\\.\\d{1,3}){3}|\\[[A-Fa-f0-9:.]+\\])(?::(?:6553[0-5]|655[0-2]\\d|65[0-4]\\d{2}|6[0-4]\\d{3}|[1-5]\\d{4}|[1-9]\\d{0,3}))?\\/api\\/v1\\/fan\\/rotate$"
                        },
                        "method": {
                          "type": "string",
                          "title": "HTTP Method",
                          "const": "POST"
                        }
                      }
                    },
                    "reset": {
                      "type": "object",
                      "title": "Reset",
                      "required": ["uri", "method"],
                      "additionalProperties": false,
                      "properties": {
                        "uri": {
                          "type": "string",
                          "format": "uri",
                          "pattern": "^https?:\\/\\/(?![^/\\s?#]*@)(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*|\\d{1,3}(?:\\.\\d{1,3}){3}|\\[[A-Fa-f0-9:.]+\\])(?::(?:6553[0-5]|655[0-2]\\d|65[0-4]\\d{2}|6[0-4]\\d{3}|[1-5]\\d{4}|[1-9]\\d{0,3}))?\\/api\\/v1\\/fan\\/reset$"
                        },
                        "method": {
                          "type": "string",
                          "const": "POST"
                        }
                      }
                    }
                  }
                },
                "auth": {
                  "type": "object",
                  "properties": {
                    "headers": {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    },
                    "bearerToken": { "type": "string" }
                  }
                }
              }
            }
          }
        },
        "definitions": {
          "endpoint": {
            "type": "object",
            "required": ["uri", "method"],
            "properties": {
              "uri": { "type": "string" },
              "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "headers": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "query": {
                "type": "object",
                "additionalProperties": { "type": ["string", "number", "boolean"] }
              }
            }
          },
          "endpointWithBody": {
            "allOf": [
              { "$ref": "#/definitions/endpoint" },
              {
                "type": "object",
                "properties": {
                  "bodyTemplate": {
                    "type": "object",
                    "description": "JSON body template where ${speed} will be replaced by 1..3"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "alias": "SimpleIrFan",
    "platform": "SimpleIrFan"
  }
}
